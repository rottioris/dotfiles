# i3 config file (v4)
#
# Please see https://i3wm.org/docs/userguide.html for a complete reference!

set $mod Mod4

# shortcuts menu
bindsym $mod+z exec --no-startup-id ~/.config/rofi/scripts/shortcuts.sh

## key gnome
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &
exec --no-startup-id dbus-update-activation-environment --systemd DISPLAY XAUTHORITY
exec --no-startup-id /usr/bin/gnome-keyring-daemon --start --components=secrets

# Font for window titles. Will also be used by the bar unless a different font
# is used in the bar {} block below.
font pango:JetBrainsMono Nerd Font 11

# This font is widely installed, provides lots of unicode glyphs, right-to-left
# text rendering and scalability on retina/hidpi displays (thanks to pango).
#font pango:DejaVu Sans Mono 8

# Start XDG autostart .desktop files using dex. See also
# https://wiki.archlinux.org/index.php/XDG_Autostart
exec --no-startup-id dex --autostart --environment i3

# background
exec_always --no-startup-id sleep 1 && feh --bg-scale ~/.config/background/snowy.jpg

# dunst (notifications)
exec --no-startup-id dunst

# Picom
exec_always --no-startup-id picom -b

# polybar
exec_always --no-startup-id ~/.config/polybar/launch_polybar.sh

# border indicator on windows:
new_window pixel 2
new_float pixel 2

# borders - always show borders
hide_edge_borders none
default_border pixel 2
default_floating_border pixel 2

# force borders on specific apps
for_window [class="code-insiders"] border pixel 2
for_window [class="firefox"] border pixel 2
for_window [class="chromium"] border pixel 2
for_window [class="google-chrome"] border pixel 2
for_window [class="Thunar"] border pixel 2

# Set inner gaps
gaps inner 6

# xss-lock grabs a logind suspend inhibit lock and will use i3lock-color to lock the
# screen before suspend. Use loginctl lock-session to lock your screen.
exec --no-startup-id xss-lock --transfer-sleep-lock -- ~/.config/i3/lock.sh

# xautolock locks after 10 minutes of inactivity (install: paru -S xautolock)
# exec --no-startup-id xautolock -time 10 -locker "~/.config/i3/lock.sh"

# lock screen manually
bindsym $mod+Shift+x exec --no-startup-id ~/.config/i3/lock.sh

# Use pactl to adjust volume in PulseAudio.
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10%
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# move tiling windows via drag & drop by left-clicking into the title bar,
# or left-clicking anywhere into the window while holding the floating modifier.
tiling_drag modifier titlebar

# start a terminal
bindsym $mod+Return exec alacritty

# kill focused window
bindsym $mod+Shift+q kill

# rofi
bindsym $mod+space exec --no-startup-id rofi -show drun
bindsym Mod4+Shift+e exec --no-startup-id ~/.config/rofi/scripts/power-manager
bindsym Mod4+a exec --no-startup-id ~/.config/rofi/scripts/audio.sh
bindsym Mod4+n exec --no-startup-id ~/.config/rofi/scripts/network.sh

# quick launch
bindsym $mod+b exec --no-startup-id helium-browser &
bindsym $mod+d exec --no-startup-id thunar &

# change focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# alternatively, you can use the cursor keys:
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# move focused window
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# alternatively, you can use the cursor keys:
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# split in vertical orientation
bindsym $mod+v split v

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# change container layout (toggle split)
bindsym $mod+e layout toggle split

# toggle tiling / floating
bindsym $mod+t floating toggle

# Define names for default workspaces
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# reload the configuration file
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r reload

# screenshot + recording
bindsym $mod+p exec ~/.config/rofi/scripts/capture.sh
bindsym $mod+Print exec ~/.config/polybar/scripts/screenshot.sh clipboard
bindsym $mod+Shift+Print exec ~/.config/polybar/scripts/screenshot.sh file

# resize window (you can also use the mouse for that)
mode "resize" {
    bindsym h resize shrink width 10 px or 10 ppt
    bindsym j resize grow height 10 px or 10 ppt
    bindsym k resize shrink height 10 px or 10 ppt
    bindsym l resize grow width 10 px or 10 ppt

    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt

    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"

######################################
# color settings for bar and windows #
######################################

# --- Paleta de colores basada en tu Wallpaper ---
# Tonos Oscuros / Fondos
set $bg_dark          #152037
set $bg_darker        #191b20
set $bg_variant       #212b35

# Tonos Medios / Bordes e Inactivos
set $slate_dark       #314256
set $slate_medium     #3c5169
set $slate_light      #4e627b

# Tonos Claros / Textos y Acentos
set $gray_blue        #6a7f97
set $text_muted       #899bae
set $text_light       #a5b3c2
set $white            #ffffff
set $urgent_red       #e53935

# --- Configuración de colores para las Ventanas ---
# Clase                     Borde           Fondo           Texto           Indicador       Borde_Hijo
client.focused              $slate_light    $bg_dark        $white          $text_light     $slate_light
client.unfocused            $bg_darker      $bg_darker      $text_muted     $bg_variant     $bg_variant
client.focused_inactive     $slate_dark     $bg_dark        $text_muted     $bg_dark        $slate_dark
client.urgent               $urgent_red     $urgent_red     $white          $urgent_red     $urgent_red
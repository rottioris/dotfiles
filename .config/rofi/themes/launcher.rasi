* {
    border: 0;
    margin: 0;
    padding: 0;
    spacing: 0;

    bg1:    #191b20;
    bg2:    #212b35;
    fg:     #a5b3c2;
    fg2:    #6a7f97;
    sel:    #a6b5c4;
    urgent: #e53935;

    background-color: transparent;
    text-color: @fg;
}

configuration {
    font: "JetBrainsMono Nerd Font 12";
    terminal: "alacritty";
    show-icons: true;
}

window {
    location: center;
    anchor: center;
    fullscreen: false;
    width: 400px;
    border: 0px solid;
    border-radius: 0px;
    border-color: @sel;
    background-color: @bg1;
}

mainbox {
    children: [ inputbar, listview ];
    background-color: transparent;
}

inputbar {
    children: [ prompt, entry ];
    background-color: @bg2;
    padding: 8px;
}

prompt {
    background-color: transparent;
    text-color: @sel;
    padding: 0px 8px 0px 0px;
}

entry {
    background-color: transparent;
    text-color: @fg;
    placeholder: "Search...";
    placeholder-color: @fg2;
}

listview {
    lines: 8;
    columns: 1;
    fixed-height: true;
    padding: 4px;
}

element {
    padding: 8px;
    border-radius: 4px;
}

element selected.normal {
    background-color: @bg2;
    text-color: @fg;
}
